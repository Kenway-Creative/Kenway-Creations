---
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/hanken-grotesk';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
const { title, description = 'Design prototype for The Horse, Shepshed.' } = Astro.props;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Prototype only: keep out of search engines so it never competes with the live site. -->
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#253A2E" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23253A2E'/%3E%3Ctext x='16' y='22' font-size='18' text-anchor='middle' fill='%23C49A61' font-family='serif'%3EH%3C/text%3E%3C/svg%3E" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <aside class="proto-bar" aria-label="Prototype notice"><strong>Unofficial concept</strong> – created independently; not commissioned, approved or endorsed by The Horse.</aside>
    <SiteHeader />
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="wrap footer__grid">
        <div>
          <p class="brand brand--foot"><span class="brand__the">The</span><span class="brand__name">Horse</span><span class="brand__place">Shepshed</span></p>
          <p>196 Ashby Road West, Shepshed, LE12 9EF</p>
          <p><a href="tel:+441509507006">01509 507006</a></p>
        </div>
        <div>
          <p class="eyebrow">About this concept</p>
          <p>An independent, unofficial design concept created without the involvement of The Horse. Wording, logo and photography are placeholders pending the owners. No cookies, analytics or third-party scripts are used, and the booking journey is a demonstration: nothing is sent, stored or confirmed.</p>
        </div>
      </div>
    </footer>
    <script>
      // Reveal-on-scroll: the simplest approach that works. Content is visible without JS or with reduced motion.
      const els = document.querySelectorAll('.reveal');
      if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) els.forEach(e => e.classList.add('in'));
      else { const io = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -10% 0px' }); els.forEach(e => io.observe(e)); }
    </script>
  </body>
</html>
