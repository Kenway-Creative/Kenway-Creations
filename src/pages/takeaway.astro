---
import { withBase } from '../lib/with-base.js';
import Base from '../layouts/Base.astro';
import '../styles/menu-manager.css';
---
<Base title="Takeaway – The Horse, Shepshed (unofficial concept)" description="Takeaway enquiries and telephone orders at The Horse, Shepshed. Call to check the menu and availability.">
  <section class="page-head">
    <div class="wrap">
      <p class="eyebrow">For evenings at home</p>
      <h1>Something good <em>to take home.</em></h1>
      <p class="lede">Staying in? Get in touch with the pub to ask what is available for takeaway.</p>
    </div>
  </section>

  <section data-menu-public="takeaway" hidden aria-label="Browser-only takeaway menu preview"></section>

  <section aria-labelledby="takeaway-plan-h" class="takeaway-page">
    <div class="wrap takeaway-page__grid">
      <div>
        <p class="eyebrow">Takeaway by telephone</p>
        <h2 id="takeaway-plan-h">Give us <em>a call.</em></h2>
        <p>Call to check which dishes are available to take away and to arrange collection. The takeaway selection may differ from the dine-in menu.</p>
        <p>This unofficial website concept does not take online orders or payments. A chef-managed takeaway menu listing is planned.</p>
        <div class="actions">
          <a class="btn btn--forest" href="tel:+441509507006">Call 01509 507006</a>
          <a class="link-arrow" href={withBase('/menus/')}>Explore our menus</a>
          <a class="btn btn--ghost btn--ghost-dark" href={withBase('/book/')}>Book a table</a>
        </div>
      </div>
      <aside class="takeaway-page__panel" aria-label="Takeaway service status">
        <p class="eyebrow">Ordering information</p>
        <h3>Order by phone.</h3>
        <p>For takeaway availability, dishes and collection arrangements, speak directly to the team on <a href="tel:+441509507006">01509 507006</a>.</p>
        <p>A current weekly takeaway menu will appear here once the chef menu manager has been implemented and the venue has approved its content.</p>
      </aside>
    </div>
  </section>
</Base>

<script>
  import { initPublicMenus } from '../lib/menu-prototype.js';
  initPublicMenus();
</script>
