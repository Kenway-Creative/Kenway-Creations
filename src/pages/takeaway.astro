---
import { withBase } from '../lib/with-base.js';
import Base from '../layouts/Base.astro';
---
<Base title="Takeaway – The Horse, Shepshed (unofficial concept)" description="Proposed takeaway collection service for The Horse, Shepshed. Online ordering is not yet available.">
  <section class="page-head">
    <div class="wrap">
      <p class="eyebrow">For evenings at home</p>
      <h1>Something good <em>to take home.</em></h1>
      <p class="lede">A thoughtfully chosen collection menu, built around what the kitchen can do well without taking anything away from the restaurant experience.</p>
    </div>
  </section>

  <section aria-labelledby="takeaway-plan-h" class="takeaway-page">
    <div class="wrap takeaway-page__grid">
      <div>
        <p class="eyebrow">Coming to this concept</p>
        <h2 id="takeaway-plan-h">From our kitchen <em>to yours.</em></h2>
        <p>The proposed service will show the dishes the chef has chosen for takeaway this week, with clear availability and collection times. The selection may differ from the restaurant menu.</p>
        <p>Online ordering is not live on this prototype. No payment or order is taken here.</p>
        <div class="actions">
          <a class="btn btn--forest" href={withBase('/menus/')}>Explore our menus</a>
          <a class="btn btn--ghost btn--ghost-dark" href={withBase('/book/')}>Book a table</a>
        </div>
      </div>
      <aside class="takeaway-page__panel" aria-label="Takeaway service status">
        <p class="eyebrow">Takeaway status</p>
        <h3>Online ordering is being planned.</h3>
        <p>Collection-only ordering, chef-controlled dishes and collection slots are proposed features, subject to approval and setup by The Horse.</p>
        <p>To ask about any takeaway options currently offered by the pub, please contact them directly on <a href="tel:+441509507006">01509 507006</a>.</p>
      </aside>
    </div>
  </section>
</Base>
