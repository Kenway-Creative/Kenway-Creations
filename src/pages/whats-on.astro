---
import Base from '../layouts/Base.astro';
import ClosingCta from '../components/ClosingCta.astro';
---
<Base title="What's on – The Horse, Shepshed (unofficial concept)" description="Events and special occasions at The Horse, Shepshed.">
  <section class="page-head">
    <div class="wrap">
      <p class="eyebrow">What's on</p>
      <h1>Events &amp; <em>special occasions.</em></h1>
      <p class="lede">Find out what's coming up at The Horse.</p>
    </div>
  </section>

  <section aria-label="Upcoming events">
    <div class="wrap">
      <p>No events are listed here yet. For the latest, please call us on <a href="tel:+441509507006">01509 507006</a>.</p>
      <p class="actions"><a class="btn btn--forest" href="tel:+441509507006">Call Us</a><a class="btn btn--ghost btn--ghost-dark" href="/find-us/">Find Us</a></p>
    </div>
  </section>

  <ClosingCta />
</Base>
